# Postgres-database (Neon: bruk «pooled connection string» med sslmode=require)
DATABASE_URL=postgres://bruker:passord@vert/startmycompany?sslmode=require

# Hovedadministrator. Opprettes ved oppstart og kan ikke slettes fra admin-siden.
ADMIN_EMAIL=
ADMIN_PASSWORD=minst-10-tegn

# Offentlig adresse (brukes til Google-innlogging)
APP_URL=http://localhost:3000

# Valgfritt: «Fortsett med Google» (Google Cloud → OAuth-klient, type «Web application»)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Valgfritt: AI-rådgiveren (Claude). Uten nøkkel virker appen, men uten AI-forklaringer.
ANTHROPIC_API_KEY=
# SMC_AI_MODEL=claude-haiku-5-5
# SMC_AI_DAILY_CAP=40

# Personvernerklæringen
LEGAL_ENTITY=Capa Capital AS
LEGAL_ORGNR=
PRIVACY_CONTACT=
